# Supabase Postgres connection string
# Get this from: Supabase Project -> Settings -> Database -> Connection string (URI, use the "Session pooler" or "Transaction pooler" URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project (optional, only needed if you also use Supabase Storage/Auth directly)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS - comma separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3000
